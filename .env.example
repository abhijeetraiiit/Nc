# ===================
# Database Configuration
# ===================

# PostgreSQL
DATABASE_URL="postgresql://nc_user:nc_password@localhost:5432/nc_ecommerce"

# MongoDB
MONGODB_URI="mongodb://nc_user:nc_password@localhost:27017/nc_ecommerce"

# Redis
REDIS_URL="redis://:nc_password@localhost:6379"

# Pinecone Vector Database (for AI service)
PINECONE_API_KEY="your-pinecone-api-key"
PINECONE_ENVIRONMENT="us-west1-gcp"

# ===================
# API Configuration
# ===================

# JWT Secret (CHANGE IN PRODUCTION!)
JWT_SECRET="nc-secret-key-change-in-production"

# Allowed Origins (CORS)
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:3002"

# API Ports
API_GATEWAY_PORT=4000
VENDOR_SERVICE_PORT=4001
PRODUCT_SERVICE_PORT=4002
ORDER_SERVICE_PORT=4003
COMPLIANCE_SERVICE_PORT=4004
AI_SERVICE_PORT=4005
NOTIFICATION_SERVICE_PORT=4006

# ===================
# External Services
# ===================

# GSTN API (for GST verification)
GSTN_API_KEY="your-gstn-api-key"
GSTN_API_URL="https://api.gstn.org"

# WhatsApp Business API
WHATSAPP_BUSINESS_TOKEN="your-whatsapp-business-token"
WHATSAPP_PHONE_NUMBER_ID="your-phone-number-id"

# Google Speech API (for voice commerce)
GOOGLE_SPEECH_API_KEY="your-google-speech-api-key"

# OpenAI API (for AI features)
OPENAI_API_KEY="your-openai-api-key"

# ===================
# Payment Gateways
# ===================

# Razorpay
RAZORPAY_KEY_ID="your-razorpay-key-id"
RAZORPAY_KEY_SECRET="your-razorpay-key-secret"

# PhonePe
PHONEPE_MERCHANT_ID="your-phonepe-merchant-id"
PHONEPE_SALT_KEY="your-phonepe-salt-key"

# ===================
# AWS Configuration
# ===================

# S3 for image storage
AWS_ACCESS_KEY_ID="your-aws-access-key"
AWS_SECRET_ACCESS_KEY="your-aws-secret-key"
AWS_REGION="ap-south-1"
S3_BUCKET="nc-ecommerce-assets"

# CloudFront CDN
CLOUDFRONT_DOMAIN="your-cloudfront-domain.cloudfront.net"

# ===================
# Email Service
# ===================

# SMTP Configuration
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-smtp-password"

# SendGrid (alternative)
SENDGRID_API_KEY="your-sendgrid-api-key"

# ===================
# SMS Service
# ===================

# Twilio
TWILIO_ACCOUNT_SID="your-twilio-account-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_PHONE_NUMBER="your-twilio-phone-number"

# ===================
# Application Settings
# ===================

NODE_ENV="development"
LOG_LEVEL="debug"

# Rate Limiting
RATE_LIMIT_TTL="60000"
RATE_LIMIT_MAX="100"

# TCS Configuration
TCS_THRESHOLD="5000000"
TCS_RATE="0.01"

# ===================
# Compliance
# ===================

# Grievance Officer Details
GRIEVANCE_OFFICER_NAME="Compliance Officer"
GRIEVANCE_OFFICER_EMAIL="grievance@nc-ecommerce.in"
GRIEVANCE_OFFICER_PHONE="+91-1234567890"

# ===================
# Feature Flags
# ===================

ENABLE_VOICE_COMMERCE="true"
ENABLE_WHATSAPP_CHECKOUT="true"
ENABLE_AI_RECOMMENDATIONS="true"
ENABLE_VECTOR_SEARCH="true"
